{
  "$schema": "https://locaryn.dev/schema/morph.json/v0.1",
  "apiVersion": "0.1",
  "name": "morph-vision-ocr",
  "version": "1.0.0-beta.1",
  "description": "NON FONCTIONNEL (squelette d'API) — Vision par ordinateur, OCR haute fidélité (Florence-2, GOT-OCR2) et détection d'objets (YOLO). Aucun moteur n'est embarqué : les appels échouent explicitement au lieu de fabriquer un résultat.",
  "author": "Locaryn Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Locaryn/morph-vision-ocr",
  "repository": "https://github.com/Locaryn/morph-vision-ocr",
  "keywords": [
    "vision",
    "ocr",
    "object-detection",
    "segmentation",
    "florence2",
    "yolo"
  ],
  "permissions": {
    "mcp": {
      "reason": "Lancer le moteur de vision et détection locale."
    },
    "files.read": {
      "reason": "Lire les images et documents scannés."
    },
    "files.write": {
      "reason": "Écrire les fichiers de transcription et visualisations."
    },
    "network": {
      "reason": "Télécharger les modèles de vision depuis HuggingFace."
    }
  },
  "components": {
    "skills": [
      "SKILL.md"
    ],
    "mcp": "mcp/mcp.json"
  },
  "capabilities": [
    "vision-ocr"
  ],
  "ui_contributions": {
    "slots": [
      {
        "id": "vision-ocr-catalog",
        "slot": "marketplace.catalogs",
        "order": 12,
        "type": "data",
        "label": "Modèles de vision et OCR",
        "icon": "target",
        "entry": "dist/marketplace.json",
        "hint": "Ajoute les modèles Florence-2 et YOLO au catalogue"
      },
      {
        "id": "vision-ocr-studio",
        "slot": "studio.tabs",
        "order": 12,
        "label": "Vision & OCR",
        "icon": "target",
        "type": "custom-element",
        "entry": "dist/ui.js",
        "tag": "locaryn-vision-ocr-panel",
        "hint": "Extraction de texte et détection d'objets"
      }
    ],
    "nav_items": [
      {
        "id": "studio",
        "label": "Studio de génération",
        "icon": "image"
      }
    ]
  },
  "beta": true,
  "stability": "untested",
  "versions": [
    {
      "version": "1.0.0-beta.1",
      "is_beta": true,
      "summary": "Version Bêta (Pre-release) — non testée par des utilisateurs",
      "tag": "v1.0.0-beta.1",
      "released_at": "2026-08-28"
    },
    {
      "version": "0.9.0",
      "is_beta": false,
      "summary": "Version de référence stable",
      "tag": "v0.9.0",
      "released_at": "2026-08-20"
    },
    {
      "version": "0.8.5",
      "is_beta": false,
      "summary": "Version précédente stable",
      "tag": "v0.8.5",
      "released_at": "2026-08-15"
    },
    {
      "version": "0.8.0",
      "is_beta": false,
      "summary": "Version initiale du socle",
      "tag": "v0.8.0",
      "released_at": "2026-08-01"
    }
  ]
}
