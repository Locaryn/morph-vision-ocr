{
  "$schema": "https://locaryn.dev/schema/morph.json/v0.1",
  "apiVersion": "0.1",
  "name": "morph-vision-ocr",
  "version": "2.1.0",
  "description": "Lire une image : texte par tesseract, description par un modèle de vision local. Sans boîtes englobantes — un modèle conversationnel n'en donne pas.",
  "author": "Locaryn Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Locaryn/morph-vision-ocr",
  "repository": "https://github.com/Locaryn/morph-vision-ocr",
  "keywords": [
    "vision",
    "ocr",
    "object-detection",
    "segmentation",
    "florence2",
    "yolo"
  ],
  "permissions": {
    "mcp": {
      "reason": "Lancer le moteur de vision et détection locale."
    },
    "files.read": {
      "reason": "Lire les images et documents scannés."
    },
    "files.write": {
      "reason": "Écrire les fichiers de transcription et visualisations."
    },
    "network": {
      "reason": "Télécharger les modèles de vision depuis HuggingFace."
    }
  },
  "components": {
    "skills": [
      "SKILL.md"
    ],
    "mcp": "mcp/mcp.json"
  },
  "capabilities": [
    "vision-ocr"
  ],
  "ui_contributions": {
    "slots": [
      {
        "id": "vision-ocr-catalog",
        "slot": "marketplace.catalogs",
        "order": 12,
        "type": "data",
        "label": "Modèles de vision et OCR",
        "icon": "target",
        "entry": "dist/marketplace.json",
        "hint": "Ajoute les modèles Florence-2 et YOLO au catalogue"
      },
      {
        "id": "vision-ocr-studio",
        "slot": "studio.tabs",
        "order": 12,
        "label": "Vision & OCR",
        "icon": "target",
        "type": "custom-element",
        "entry": "dist/ui.js",
        "tag": "locaryn-vision-ocr-panel",
        "hint": "Extraction de texte et détection d'objets"
      }
    ],
    "nav_items": [
      {
        "id": "studio",
        "label": "Studio de génération",
        "icon": "image"
      }
    ]
  },
  "beta": true,
  "stability": "untested",
  "versions": [
    {
      "version": "2.1.0-beta.1",
      "is_beta": true,
      "summary": "Version Bêta (2.1.0-beta.1) — pre-release non testée par des utilisateurs",
      "tag": "v2.1.0-beta.1",
      "released_at": "2026-08-29",
      "install_source": "Locaryn/morph-vision-ocr#v2.1.0-beta.1"
    },
    {
      "version": "2.0.0",
      "is_beta": false,
      "summary": "Version stable de référence v2.0.0",
      "tag": "v2.0.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-vision-ocr#v2.0.0"
    },
    {
      "version": "1.5.0",
      "is_beta": false,
      "summary": "Version stable de référence v1.5.0",
      "tag": "v1.5.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-vision-ocr#v1.5.0"
    },
    {
      "version": "1.0.0",
      "is_beta": false,
      "summary": "Version stable de référence v1.0.0",
      "tag": "v1.0.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-vision-ocr#v1.0.0"
    }
  ]
}
